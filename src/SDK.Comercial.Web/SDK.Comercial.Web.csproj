<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RootNamespace>SDK.Comercial.Web</RootNamespace>
        <AssemblyName>SDK.Comercial.Web</AssemblyName>
        <!-- MGWServicios.dll es de 32 bits: el proceso debe ser x86. -->
        <PlatformTarget>x86</PlatformTarget>
        <RuntimeIdentifier>win-x86</RuntimeIdentifier>
        <SelfContained>false</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SDK.Comercial.Application\SDK.Comercial.Application.csproj" />
        <ProjectReference Include="..\SDK.Comercial.Domain\SDK.Comercial.Domain.csproj" />
        <ProjectReference Include="..\SDK.Comercial.Infrastructure\SDK.Comercial.Infrastructure.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    </ItemGroup>

</Project>
